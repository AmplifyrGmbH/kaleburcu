RewriteEngine On

# HTTP -> HTTPS erzwingen
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Nicht-www -> www erzwingen
RewriteCond %{HTTP_HOST} ^kaleburcu\.ch$ [NC]
RewriteRule ^ https://www.kaleburcu.ch%{REQUEST_URI} [L,R=301]

# Umgezogene Kategorie-Seiten (ehemals produkte/honig.html, oliven.html, gewuerze.html, olivenoel.html, firmengeschenke.html)
RewriteRule ^produkte/honig/?$ /produkte [R=301,L]
RewriteRule ^produkte/oliven/?$ /produkte [R=301,L]
RewriteRule ^produkte/gewuerze/?$ /produkte [R=301,L]
RewriteRule ^produkte/olivenoel/?$ /produkte/olivenoel-500ml [R=301,L]
RewriteRule ^produkte/firmengeschenke/?$ /#b2b [R=301,L]

# xxx.html aufgerufen -> auf /xxx umleiten (verhindert doppelten Content)
RewriteCond %{THE_REQUEST} \s/+([^?\s]+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# /xxx angefragt -> intern xxx.html ausliefern
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^.]+)$ $1.html [L]

# Eigene 404-Seite
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  # Clickjacking verhindern
  Header always set X-Frame-Options "SAMEORIGIN"
  # MIME-Type-Sniffing verhindern
  Header always set X-Content-Type-Options "nosniff"
  # Referrer-Informationen begrenzen
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # XSS-Schutz (Legacy-Browser)
  Header always set X-XSS-Protection "1; mode=block"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType video/webm "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>
